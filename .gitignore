# Python
__pycache__/
*.pyc

# 构建产物（由 build_site.py 生成；gh-pages 由 Actions 管理，不提交）
dist/
.deploy_tmp/

# 密钥与本地配置（绝不入库）
*.token
.env
sync_config.json
tools/sync_config.json
secrets.*
*.secret

# 操作系统
.DS_Store
Thumbs.db
logs/
logs_collect.txt

# 临时探针文件（非仓库内容）
.tool_probe.tmp

# 注意：.github/workflows/ 必须入库，GitHub Actions 才能运行。
# 推送需带 workflow scope 的令牌（gh auth login 或具 workflow 权限的 PAT）。
# 本次收口仅纳入 asip-pipeline.yml；以下两个本地工作流非本阶段内容，暂不入库。
.github/workflows/auto-update.yml
.github/workflows/deploy.yml

# 运行锁（本地运行时状态，绝不入库）
data/.pipeline.lock
.dist_trash/
.dist_new/

# Stage2 本地自动备份与验证临时目录（不入库）
data/**/.backups/
data/.backups/
data/.trash_*/

data/backup/

# Stage 2.5A 内部 AI 目录：运行时内容绝不入库（保留 .gitkeep 占位空目录）
data/ai/**/*.json
data/ai/queue/*
data/ai/processing/*
data/ai/completed/*
data/ai/failed/*
data/ai/cache/*
data/ai/usage/*
# Stage 2.5B-1 内部目录：批次/租约/审计/锁运行内容绝不入库
data/ai/batches/*
data/ai/leases/*
data/ai/audit/*
data/ai/locks/*
data/ai/**/*.md
!data/ai/**/.gitkeep

# Stage 2.5B-2A 单会话手工交接演示运行时（绝不入库）
.workbuddy_runtime/

data/runtime/

# QA headless browser profile (never committed)
.qa-edge-profile/
qa-artifacts-depth-d/scratch/
