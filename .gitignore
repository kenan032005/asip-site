# Python
__pycache__/
*.pyc

# 构建产物（由 build_site.py 生成；gh-pages 由 Actions 管理，不提交）
dist/
.deploy_tmp/

# 密钥与本地配置（绝不入库）
*.token
.env
sync_config.json
tools/sync_config.json
secrets.*
*.secret

# 操作系统
.DS_Store
Thumbs.db
logs/
logs_collect.txt

# 临时探针文件（非仓库内容）
.tool_probe.tmp

# PAT 无 workflow scope，Actions 文件暂不入库（本地保留，需手动上传或换带 workflow scope 的 PAT）
.github/workflows/

# 运行锁（本地运行时状态，绝不入库）
data/.pipeline.lock
.dist_trash/
.dist_new/

# Stage2 本地自动备份与验证临时目录（不入库）
data/**/.backups/
data/.backups/
data/.trash_*/

data/backup/

# Stage 2.5A 内部 AI 目录：运行时内容绝不入库（保留 .gitkeep 占位空目录）
data/ai/**/*.json
data/ai/queue/*
data/ai/processing/*
data/ai/completed/*
data/ai/failed/*
data/ai/cache/*
data/ai/usage/*
# Stage 2.5B-1 内部目录：批次/租约/审计/锁运行内容绝不入库
data/ai/batches/*
data/ai/leases/*
data/ai/audit/*
data/ai/locks/*
data/ai/**/*.md
!data/ai/**/.gitkeep

