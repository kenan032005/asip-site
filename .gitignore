# Python
__pycache__/
*.pyc

# 构建产物（由 build_site.py 生成；gh-pages 由 Actions 管理，不提交）
dist/
.deploy_tmp/

# 密钥与本地配置（绝不入库）
*.token
.env
sync_config.json
tools/sync_config.json
secrets.*
*.secret

# 操作系统
.DS_Store
Thumbs.db
logs/
logs_collect.txt

# PAT 无 workflow scope，Actions 文件暂不入库（本地保留，需手动上传或换带 workflow scope 的 PAT）
.github/workflows/

# 运行锁（本地运行时状态，绝不入库）
data/.pipeline.lock
.dist_trash/
.dist_new/
.dist_new/
