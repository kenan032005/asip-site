# ASIP 运行配置示例（仅空值 / 示例变量名，绝不包含真实密钥）
# 复制为 .env 后填写；.env 已被 .gitignore 忽略，绝不入库。

# ── 运行模式 ──
ASIP_RUNTIME=workbuddy_local
ASIP_AI_PROVIDER=workbuddy_queue
ASIP_AI_MODEL=hy3
ASIP_ALLOW_PAID_FALLBACK=false
ASIP_CLOUD_SCHEDULE_ENABLED=false
ASIP_AI_PROCESSING_ENABLED=false

# ── 付费 Provider 凭证（仅在未来显式启用 openai_api / generic_api 时填写）──
# 当前 Stage 2.5A 不启用、不检查、不调用这些密钥。
OPENAI_API_KEY=
GENERIC_AI_API_KEY=
GENERIC_AI_BASE_URL=
