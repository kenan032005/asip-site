{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://asip.local/schemas/article.schema.json",
  "title": "Article",
  "description": "规范 Article 模型（一篇原始新闻/报告）。与 Event 彻底分离。",
  "type": "object",
  "required": [
    "article_id", "schema_version", "pipeline_version", "run_id",
    "source_id", "article_url", "processing_status", "verification_queue_status"
  ],
  "properties": {
    "article_id": {"type": "string", "pattern": "^ART_[0-9a-f]{16}$"},
    "schema_version": {"type": "string", "const": "2.0"},
    "pipeline_version": {"type": "integer", "const": 2},
    "run_id": {"type": "string", "pattern": "^\\d{8}T\\d{6}\\+0800_[a-z0-9]{6}$"},
    "source_id": {"type": "string", "minLength": 1},
    "source_group": {"type": "string"},
    "source_name": {"type": "string"},
    "source_type": {"type": "string", "enum": ["government", "military_or_police", "international_media", "state_media", "local_media", "humanitarian", "international_organization", "ngo", "research", "social_media", "aggregation_platform", "other"]},
    "source_reliability_tier": {"type": "string", "enum": ["tier_1", "tier_2", "tier_3", "lead_only"]},
    "claim_origin_type": {"type": "string", "enum": ["direct_government_statement", "direct_military_statement", "direct_international_organization_report", "direct_humanitarian_report", "media_reporting", "ngo_report", "commentary", "unknown"]},
    "article_url": {"type": "string", "format": "uri"},
    "canonical_url": {"type": "string", "format": "uri"},
    "title_original": {"type": "string"},
    "summary_original": {"type": "string"},
    "content_excerpt": {"type": "string"},
    "language": {"type": "string", "enum": ["zh", "en", "fr", "ar", "es", "pt", "ru", "de", "ja", "it", "tr", "ha", "sw", "und"]},
    "published_at": {"type": ["string", "null"], "format": "date-time"},
    "retrieved_at": {"type": ["string", "null"], "format": "date-time"},
    "updated_at": {"type": ["string", "null"], "format": "date-time"},
    "detected_country": {"type": "string"},
    "event_country": {"type": "string"},
    "mentioned_countries": {"type": "array", "items": {"type": "string"}},
    "regional_scope": {"type": "string"},
    "country_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "detected_locations": {"type": "array", "items": {"type": "string"}},
    "event_type": {"type": "string"},
    "relevance_score": {"type": "number", "minimum": 0, "maximum": 1},
    "is_security_relevant": {"type": "boolean"},
    "china_related": {"type": "boolean"},
    "title_cn": {"type": "string"},
    "summary_cn": {"type": "string"},
    "content_hash": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "processing_status": {"type": "string", "enum": ["raw", "normalized", "classified", "queued_for_verification", "linked_to_event", "quarantined", "archived"]},
    "verification_queue_status": {"type": "string", "enum": ["not_required", "waiting", "searching", "completed", "expired", "failed"]},
    "linked_event_id": {"type": ["string", "null"], "pattern": "^EVT_[0-9a-f]{16}$"},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "errors": {"type": "array", "items": {"type": "string"}},
    "legacy_payload": {"type": "object"}
  },
  "additionalProperties": true
}
