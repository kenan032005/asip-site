{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://asip-site.local/schemas/ai_enrichment.schema.json",
  "title": "ASIP Stage 4 AI Enrichment (v2)",
  "description": "Stage 4 AI 增强数据合同 v2。字段分为模型输出字段（MODEL_OUTPUT_FIELDS）和系统可信元数据（由 Processor 注入，不信任模型）。每条记录以 result_id 为唯一键，多模型/多版本结果并存。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "result_id",
    "event_id",
    "canonical_run_id",
    "input_hash",
    "source_language",
    "title_zh",
    "summary_zh",
    "event_type",
    "country_iso3",
    "location",
    "key_facts",
    "uncertainties",
    "security_relevance",
    "classification_confidence",
    "ai_provider",
    "ai_model",
    "prompt_version",
    "prompt_content_hash",
    "processed_at",
    "processing_status",
    "error_code"
  ],
  "properties": {
    "result_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256(event_id|input_hash|prompt_version|prompt_content_hash|provider|model)"
    },
    "cache_key": {
      "type": "string",
      "description": "等效于 result_id"
    },
    "event_id": {
      "type": "string",
      "pattern": "^EVT_[0-9a-f]{16}$"
    },
    "canonical_run_id": {
      "type": "string",
      "pattern": "^\\d{8}T\\d{6}\\+0800_[a-z0-9]{6}$"
    },
    "input_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_language": {
      "type": "string",
      "minLength": 2,
      "description": "BCP-47 兼容语言标签（fr/en/ar/es/zh/pt/de/ha/sw/so/am/unknown 等）"
    },
    "title_zh": {"type": "string", "minLength": 5, "maxLength": 60},
    "summary_zh": {"type": "string", "minLength": 20, "maxLength": 400},
    "event_type": {
      "type": "string",
      "enum": [
        "armed_conflict", "terrorism", "civil_unrest", "political_instability",
        "crime_kidnapping", "border_security", "transport_disruption",
        "infrastructure_incident", "natural_disaster", "other_security"
      ]
    },
    "country_iso3": {
      "type": "string",
      "pattern": "^[A-Z]{3}$",
      "description": "必须非 null，与 Canonical primary_country 的 ISO3 一致"
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["country_iso3", "admin1", "city", "site", "raw_text"],
      "properties": {
        "country_iso3": {"type": ["string", "null"], "pattern": "^[A-Z]{3}$"},
        "admin1": {"type": ["string", "null"]},
        "city": {"type": ["string", "null"]},
        "site": {"type": ["string", "null"]},
        "raw_text": {"type": "string"}
      }
    },
    "key_facts": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["fact", "evidence_field", "evidence_excerpt"],
        "properties": {
          "fact": {"type": "string", "minLength": 5},
          "evidence_field": {"type": "string",
            "enum": ["title_original","body_extracted","event_time","location","source_links"]},
          "evidence_excerpt": {"type": "string", "maxLength": 300}
        }
      }
    },
    "uncertainties": {"type": "array", "items": {"type": "string", "minLength": 3}},
    "security_relevance": {"type": "string", "enum": ["direct", "indirect", "none"]},
    "classification_confidence": {"type": "integer", "minimum": 0, "maximum": 100},
    "ai_provider": {"type": "string", "minLength": 1},
    "ai_model": {"type": "string", "minLength": 1},
    "prompt_version": {"type": "string", "minLength": 1},
    "prompt_content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "processed_at": {"type": "string", "format": "date-time"},
    "processing_status": {
      "type": "string",
      "enum": ["pending","processing","succeeded","failed_retryable","failed_terminal","skipped_ineligible","invalid_model_output"]
    },
    "error_code": {"type": ["string", "null"]},
    "raw_response_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
  }
}
