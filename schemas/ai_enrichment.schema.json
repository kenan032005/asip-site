{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://asip-site.local/schemas/ai_enrichment.schema.json",
  "title": "ASIP Stage 4 AI Enrichment",
  "description": "Stage 4 AI 增强数据合同。每条记录以 Canonical event_id 为唯一关联键，AI 输出经解析+Schema 校验+语义校验后写入，不改动 Canonical 原始数据。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "canonical_run_id",
    "input_hash",
    "source_language",
    "title_zh",
    "summary_zh",
    "event_type",
    "country_iso3",
    "location",
    "key_facts",
    "uncertainties",
    "security_relevance",
    "classification_confidence",
    "ai_provider",
    "ai_model",
    "prompt_version",
    "processed_at",
    "processing_status",
    "error_code"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^EVT_[0-9a-f]{16}$",
      "description": "Canonical 事件唯一键"
    },
    "canonical_run_id": {
      "type": "string",
      "pattern": "^\\d{8}T\\d{6}\\+0800_[a-z0-9]{6}$",
      "description": "产生该事件的 canonical 采集 run_id"
    },
    "input_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "影响 AI 输出的 Canonical 字段哈希（original_title+body_extracted+primary_country+event_time+canonical_url）"
    },
    "source_language": {
      "type": "string",
      "enum": ["fr", "en", "ar", "es", "de", "pt", "zh", "unknown"]
    },
    "title_zh": {
      "type": "string",
      "minLength": 5,
      "maxLength": 60,
      "description": "中文标题，建议 15-35 汉字，保留核心事件/地点/主体，无夸张，无'据报道'前缀"
    },
    "summary_zh": {
      "type": "string",
      "minLength": 20,
      "maxLength": 400,
      "description": "中文摘要，建议 80-160 汉字，说明发生了什么/在哪里/涉及谁/造成何种结果，严格基于输入"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "armed_conflict",
        "terrorism",
        "civil_unrest",
        "political_instability",
        "crime_kidnapping",
        "border_security",
        "transport_disruption",
        "infrastructure_incident",
        "natural_disaster",
        "other_security"
      ],
      "description": "固定枚举，不允许模型自由创造类别。映射：canonical terrorist_attack→terrorism, military_operation→armed_conflict, public_health→other_security, strike→civil_unrest"
    },
    "country_iso3": {
      "type": ["string", "null"],
      "pattern": "^[A-Z]{3}$",
      "description": "必须与 Canonical primary_country 一致，模型不得改变事件所属国家"
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["country_iso3", "admin1", "city", "site", "raw_text"],
      "properties": {
        "country_iso3": {"type": ["string", "null"], "pattern": "^[A-Z]{3}$"},
        "admin1": {"type": ["string", "null"]},
        "city": {"type": ["string", "null"]},
        "site": {"type": ["string", "null"]},
        "raw_text": {"type": "string"}
      }
    },
    "key_facts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fact", "evidence_field", "evidence_excerpt"],
        "properties": {
          "fact": {"type": "string", "minLength": 5},
          "evidence_field": {
            "type": "string",
            "enum": ["title_original", "body_extracted", "event_time", "location", "source_links"]
          },
          "evidence_excerpt": {"type": "string", "maxLength": 300}
        }
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {"type": "string", "minLength": 3},
      "description": "始终存在，允许空数组；原文不确定处必须保留，模型不得自行消除"
    },
    "security_relevance": {
      "type": "string",
      "enum": ["direct", "indirect", "none"]
    },
    "classification_confidence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100,
      "description": "仅表示分类置信度，不表示事件真实性或风险等级"
    },
    "ai_provider": {
      "type": "string",
      "enum": ["mock", "workbuddy_queue", "openai_api", "generic_api", "disabled", "hy3"]
    },
    "ai_model": {"type": "string", "minLength": 1},
    "prompt_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "processed_at": {"type": "string", "format": "date-time"},
    "processing_status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "succeeded",
        "failed_retryable",
        "failed_terminal",
        "skipped_ineligible",
        "invalid_model_output"
      ]
    },
    "error_code": {"type": ["string", "null"]},
    "raw_response_hash": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$",
      "description": "原始响应的 SHA-256 哈希（仅哈希入库，原文不外发）"
    }
  }
}
