{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://asip.local/schemas/event_cluster.schema.json",
  "title": "EventCluster",
  "description": "规范 Event Cluster 模型（现实世界一件事件）。与 Article 彻底分离；国家风险等级与事件严重程度分离；处理状态与发布状态分离。",
  "type": "object",
  "required": [
    "event_id", "schema_version", "pipeline_version", "run_id",
    "country_code", "event_type", "event_severity", "event_status",
    "verification_level", "publication_status"
  ],
  "properties": {
    "event_id": {"type": "string", "pattern": "^EVT_[0-9a-f]{16}$"},
    "schema_version": {"type": "string", "const": "2.0"},
    "pipeline_version": {"type": "integer", "const": 2},
    "run_id": {"type": "string", "pattern": "^\\d{8}T\\d{6}\\+0800_[a-z0-9]{6}$"},
    "legacy_event_id": {"type": "string"},
    "country_code": {"type": "string", "minLength": 2, "maxLength": 2},
    "country_cn": {"type": "string"},
    "country_risk_level": {"type": "integer", "minimum": 1, "maximum": 4},
    "country_risk_label": {"type": "string"},
    "event_type": {"type": "string"},
    "event_severity": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
    "event_status": {"type": "string", "enum": ["new", "ongoing", "developing", "easing", "ended", "unknown"]},
    "event_time": {"type": "string", "format": "date-time"},
    "event_time_end": {"type": "string", "format": "date-time"},
    "location_name": {"type": "string"},
    "location_admin1": {"type": "string"},
    "location_admin2": {"type": "string"},
    "latitude": {"type": ["number", "null"]},
    "longitude": {"type": ["number", "null"]},
    "title_cn": {"type": "string"},
    "title_original": {"type": "string"},
    "summary_cn": {"type": "string"},
    "summary_original": {"type": "string"},
    "article_ids": {"type": "array", "items": {"type": "string", "pattern": "^ART_[0-9a-f]{16}$"}},
    "source_groups": {"type": "array", "items": {"type": "string"}},
    "independent_source_count": {"type": "integer", "minimum": 0},
    "verification_level": {"type": "string", "enum": ["not_checked", "insufficient_information", "single_source", "high_reliability_single_source", "direct_official_source", "cross_verified", "conflicting_reports"]},
    "verification_score": {"type": "integer", "minimum": 0, "maximum": 100},
    "verification_notes": {"type": "array", "items": {"type": "string"}},
    "conflicting_fields": {"type": "array", "items": {"type": "string"}},
    "publication_status": {"type": "string", "enum": ["verification_pending", "publishable", "published", "suppressed", "quarantined", "archived"]},
    "publication_reason": {"type": "string"},
    "quality_gate_passed": {"type": "boolean"},
    "verification_label_cn": {"type": "string"},
    "china_related": {"type": "boolean"},
    "potential_impact": {"type": "string"},
    "current_progress": {"type": "string"},
    "legacy_promotion_class": {"type": "string"},
    "legacy_publication_status": {"type": "string"},
    "first_seen_at": {"type": "string", "format": "date-time"},
    "last_seen_at": {"type": "string", "format": "date-time"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "legacy_payload": {"type": "object"}
  },
  "additionalProperties": true
}
