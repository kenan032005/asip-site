{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "compared_source_ids",
    "agreements",
    "conflicts",
    "unique_claims",
    "confidence",
    "synthetic"
  ],
  "properties": {
    "compared_source_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "agreements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unique_claims": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "unresolved_facts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_quality_assessment": {
      "type": "object"
    },
    "recommended_fact_status": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "synthetic": {
      "type": "boolean"
    }
  }
}