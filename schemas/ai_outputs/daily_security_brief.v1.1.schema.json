{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_date",
    "geographic_scope",
    "overall_assessment",
    "risk_direction",
    "key_events",
    "risk_increases",
    "risk_decreases",
    "china_related_items",
    "project_operational_impacts",
    "management_attention",
    "information_gaps",
    "confidence",
    "synthetic"
  ],
  "properties": {
    "report_date": {
      "type": "string"
    },
    "geographic_scope": {
      "type": "string"
    },
    "overall_assessment": {
      "type": "string"
    },
    "risk_direction": {
      "type": "string",
      "enum": [
        "improving",
        "stable",
        "deteriorating",
        "volatile"
      ]
    },
    "key_events": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "risk_increases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk_decreases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "china_related_items": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "project_operational_impacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "management_attention": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "information_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "synthetic": {
      "type": "boolean"
    }
  }
}