{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://asip-site.local/schemas/prompt_package.schema.json",
  "title": "ASIP Prompt Package",
  "description": "Stage 2.5C-1 Prompt Package 契约",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "prompt_id",
    "task_type",
    "version",
    "status",
    "system_template",
    "user_template",
    "required_variables",
    "optional_variables",
    "output_schema",
    "output_schema_version",
    "output_language",
    "checksum",
    "description",
    "untrusted_variables"
  ],
  "properties": {
    "prompt_id": {
      "type": "string",
      "minLength": 1
    },
    "task_type": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "deprecated",
        "disabled"
      ]
    },
    "system_template": {
      "type": "string",
      "minLength": 1
    },
    "user_template": {
      "type": "string",
      "minLength": 1
    },
    "required_variables": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "optional_variables": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "output_schema": {
      "type": "string",
      "minLength": 1
    },
    "output_schema_version": {
      "type": "string"
    },
    "output_language": {
      "type": "string",
      "minLength": 1
    },
    "checksum": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "description": {
      "type": "string"
    },
    "untrusted_variables": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  }
}