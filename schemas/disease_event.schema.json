{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://asip.local/schemas/disease_event.schema.json",
  "title": "ASIP Stage 5 — 传染病事件（Disease Event）",
  "description": "独立于社会安全的传染病数据链 canonical 记录。所有数字字段未知时必须为 null，不得用 0 代替未知。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "disease_event_id", "disease_id", "disease_name_en", "disease_name_zh",
    "country_iso3", "location_raw", "report_date",
    "outbreak_status", "update_type",
    "source_links", "primary_source", "source_tier",
    "verification_status", "verification_confidence",
    "created_at", "updated_at"
  ],
  "properties": {
    "disease_event_id": { "type": "string", "pattern": "^DSEV_[0-9a-f]{16}$" },
    "disease_id": { "type": "string", "minLength": 2 },
    "disease_name_en": { "type": "string" },
    "disease_name_zh": { "type": "string" },
    "pathogen": { "type": ["string", "null"] },
    "country_iso3": { "type": ["string", "null"], "pattern": "^[A-Z]{3}$|^$|regional" },
    "admin1": { "type": ["string", "null"] },
    "admin2": { "type": ["string", "null"] },
    "location_raw": { "type": ["string", "null"] },
    "report_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "event_start_date": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "event_end_date": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "confirmed_cases": { "type": ["integer", "null"], "minimum": 0 },
    "probable_cases": { "type": ["integer", "null"], "minimum": 0 },
    "suspected_cases": { "type": ["integer", "null"], "minimum": 0 },
    "total_cases": { "type": ["integer", "null"], "minimum": 0 },
    "deaths": { "type": ["integer", "null"], "minimum": 0 },
    "recoveries": { "type": ["integer", "null"], "minimum": 0 },
    "case_count_type": {
      "type": "string",
      "enum": ["source_total", "computed_total", "confirmed_only", "unknown"]
    },
    "case_period_start": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "case_period_end": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "outbreak_status": {
      "type": "string",
      "enum": ["active", "monitoring", "declining", "contained", "ended", "unknown"]
    },
    "update_type": {
      "type": "string",
      "enum": ["new_outbreak", "case_update", "geographic_spread", "mortality_update",
               "response_update", "status_change", "final_update"]
    },
    "cross_border": { "type": "boolean" },
    "affected_countries": { "type": "array", "items": { "type": "string" } },
    "source_links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "source_id", "source_name", "source_tier"],
        "properties": {
          "url": { "type": "string" },
          "source_id": { "type": "string" },
          "source_name": { "type": "string" },
          "source_tier": { "type": "string", "enum": ["A", "B", "C", "D"] }
        }
      }
    },
    "primary_source": { "type": "string" },
    "source_tier": { "type": "string", "enum": ["A", "B", "C", "D"] },
    "verification_status": {
      "type": "string",
      "enum": ["official", "corroborated", "single_source", "data_difference", "temporal_update", "unverified"]
    },
    "verification_confidence": { "type": "integer", "minimum": 0, "maximum": 100 },
    "previous_event_id": { "type": ["string", "null"] },
    "supersedes_event_id": { "type": ["string", "null"] },
    "data_quality_flags": { "type": "array", "items": { "type": "string" } },
    "uncertainties": { "type": "array", "items": { "type": "string" } },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" }
  }
}
