{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ASIP Major Event Brief Input",
  "description": "Stage 7A §二十一 — 重大事件简报 INPUT contract（内部）。非 schedule，条件触发（§十九）；trigger_score ≥ 阈值 → brief_candidate（§二十）。本阶段只生成 trigger_candidate，不自动发布。facts/analysis_inputs/uncertainties/source_evidence 分层（§十二）。",
  "type": "object",
  "required": [
    "brief_id", "report_type", "trigger_score", "trigger_reasons",
    "event_id", "country", "event_type", "candidate_status"
  ],
  "properties": {
    "brief_id": {"type": "string"},
    "report_type": {"const": "major_event_brief"},
    "generated_at": {"type": "string"},
    "trigger_score": {"type": "integer", "minimum": 0, "maximum": 100},
    "trigger_threshold": {"type": "integer"},
    "trigger_reasons": {"type": "array", "items": {"type": "string"}},
    "candidate_status": {"type": "string", "enum": ["brief_candidate", "below_threshold"]},
    "event_id": {"type": "string"},
    "master_event_id": {"type": ["string", "null"]},
    "country": {"type": ["string", "null"]},
    "country_iso3": {"type": ["string", "null"]},
    "event_type": {"type": ["string", "null"]},
    "event_time": {"type": ["string", "null"]},
    "location": {"type": ["string", "null"]},
    "verification": {"type": ["string", "null"]},
    "verification_confidence": {"type": ["integer", "null"]},
    "source_count": {"type": "integer", "minimum": 0},
    "conflicting": {"type": "boolean", "default": false},
    "facts": {"type": "array", "items": {"type": "object"}},
    "analysis_inputs": {"type": "array", "items": {"type": "string"}},
    "uncertainties": {"type": "array", "items": {"type": "string"}},
    "source_evidence": {"type": "array", "items": {"type": "object"}}
  }
}
