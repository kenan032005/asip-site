+def find_existing_task_by_cache_key(cache_key, ai_root=AI_ROOT):
+    """按 completed -> processing -> queue -> failed -> cache 顺序查找同一 cache_key 的任务。
+
+    这是「全状态幂等」的核心：任一状态目录中已存在同一 cache_key 的任务，
