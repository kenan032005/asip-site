{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://asip-site.local/schemas/ai_result.schema.json",
  "title": "ASIP AI Result",
  "description": "Stage 2.5A AI 结果契约（强化）。本阶段结果不真正产生（Worker 在 2.5B 建设）。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "schema_version",
    "status",
    "provider",
    "model",
    "started_at",
    "completed_at",
    "result",
    "error",
    "usage"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^AIT_[0-9a-f]{24}$"
    },
    "schema_version": { "type": "string", "pattern": "^1\\.0$" },
    "status": {
      "type": "string",
      "enum": ["success", "failed", "refused", "invalid_output"]
    },
    "provider": {
      "type": "string",
      "enum": ["workbuddy_queue", "openai_api", "generic_api", "disabled", "none"]
    },
    "model": { "type": "string", "minLength": 1 },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "result": { "type": "object" },
    "error": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "estimated_cost_usd"],
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "estimated_cost_usd": { "type": "number", "minimum": 0 }
      }
    }
  }
}
