   "location": "",
   "china_related": false,
   "verification_level": "single_source",
   "verification_label_cn": "单一来源",
   "independent_source_count": 1,
   "source_links": [
    {
     "url": "https://www.alwihdainfo.com/ndjamena-transformer-la-menace-des-eaux-pluviales-en-opportunite-economique/",
