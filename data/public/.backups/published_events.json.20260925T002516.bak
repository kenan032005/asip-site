   "independent_source_count": 1,
   "source_links": [
    {
     "url": "https://anp.ne/diffa-le-gouverneur-apporte-le-soutien-des-plus-hautes-autorites-aux-forces-de-defense-et-de-securite-a-nguigmi-et-appelle-a-poursuivre-le-combat-contre-le-terrorisme/",
