   "title_original": "Violences au Grand marché de N'Djamena : le TGI renvoie le dossier pour supplément d'information",
   "summary_cn": "",
   "summary_original": "Le Tribunal de grande instance de N'Djamena a renvoyé l'affaire de violences survenue au Grand Marché pour exiger la comparution de nouveaux protagonistes, maintenant le prévenu en détention.",
   "event_time": "2026-09-19T17:58:19Z",
   "published_time": "2026-09-19T17:58:19Z",
   "location": "",
   "china_related": false,
   "verification_level": "single_source",
   "verification_label_cn": "单一来源",
   "independent_source_count": 1,
   "source_links": [
    {
     "url": "https://www.alwihdainfo.com/violences-au-grand-marche-de-ndjamena-le-tgi-renvoie-le-dossier-pour-supplement-dinformation/",
     "source_name": "Alwihda Info",
