   "verification_label_cn": "单一来源",
   "independent_source_count": 1,
   "source_links": [
    {
     "url": "https://tchadinfos.com/2026/09/22/lac-tchad-loms-et-larabie-saoudite-lancent-un-programme-de-53-millions-de-dollars-contre-le-cholera/",
     "source_name": "Tchadinfos",
