   "title_original": "Tchad : le gouvernement au chevet des populations frappées par le manque de pluies",
   "summary_cn": "",
   "summary_original": "Une délégation ministérielle est arrivée à Ati pour évaluer l'impact du déficit pluviométrique dans la province du Batha et répondre aux besoins des populations face à la sécheresse.",
   "event_time": "2026-09-17T20:51:13Z",
   "published_time": "2026-09-17T20:51:13Z",
   "location": "",
   "china_related": false,
   "verification_level": "single_source",
   "verification_label_cn": "单一来源",
   "independent_source_count": 1,
   "source_links": [
    {
     "url": "https://www.alwihdainfo.com/tchad-le-gouvernement-au-chevet-des-populations-frappees-par-le-manque-de-pluies/",
     "source_name": "Alwihda Info",
     "source_group": "chad",
