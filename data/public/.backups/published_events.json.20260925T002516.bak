   "verification_level": "single_source",
   "verification_label_cn": "单一来源",
   "independent_source_count": 1,
   "source_links": [
    {
     "url": "https://www.alwihdainfo.com/histoire-ouadi-doum-un-ancien-chef-detat-major-libyen-raconte-les-choix-militaires-qui-ont-precede-la-defaite/",
