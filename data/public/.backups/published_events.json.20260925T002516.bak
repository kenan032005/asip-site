   "title_original": "Ouverture d’un atelier de vulgarisation du Manuel de référence de lutte contre les violences basées sur le genre (VBG)",
   "summary_cn": "",
   "summary_original": "",
   "event_time": "2026-09-15T00:14:47Z",
   "published_time": "2026-09-15T00:14:47Z",
   "location": "",
   "china_related": false,
   "verification_level": "single_source",
   "verification_label_cn": "单一来源",
   "independent_source_count": 1,
   "source_links": [],
   "potential_impact": "",
   "progress": "",
   "current_policy_passed": true,
   "quality_gate_passed": true,
