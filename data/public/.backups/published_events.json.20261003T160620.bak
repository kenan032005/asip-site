   "location": "",
   "china_related": false,
   "verification_level": "single_source",
   "verification_label_cn": "单一来源",
   "independent_source_count": 1,
   "source_links": [
    {
     "url": "https://anp.ne/le-cycle-de-la-commande-publique-au-niger-un-processus-rigoureux-fonde-sur-la-necessite-de-garantir-et-consolider-la-bonne-gouvernance-economique-et-financiere/",
