   "verification_label_cn": "单一来源",
   "independent_source_count": 1,
   "source_links": [
    {
     "url": "https://interieur.gouv.ne/dosso-la-tournee-nationale-de-sensibilisation-sur-les-reformes-de-letat-civil-et-de-lidentification-des-personnes-se-poursuit/?utm_source=rss&utm_medium=rss&utm_campaign=dosso-la-tournee-nationale-de-sensibilisation-sur-les-reformes-de-letat-civil-et-de-lidentification-des-personnes-se-poursuit",
     "source_name": "Ministère de l'Intérieur（尼日尔内政部）",
