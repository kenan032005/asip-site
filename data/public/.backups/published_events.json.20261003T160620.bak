   "published_time": "2026-09-17T21:27:10Z",
   "location": "",
   "china_related": false,
   "verification_level": "single_source",
   "verification_label_cn": "单一来源",
   "independent_source_count": 1,
   "source_links": [
    {
     "url": "https://tamtaminfo.com/un-acte-de-refondation-le-president-tiani-compose-une-equipe-de-combat-pour-les-defis-du-niger/",
