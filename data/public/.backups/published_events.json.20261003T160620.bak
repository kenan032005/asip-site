   "title_cn": "南苏丹琼莱州杜克县社区间武装冲突持续",
   "title_original": "The fighting continued",
   "summary_cn": "南苏丹琼莱州杜克县霍尔社区与来自特维克东县阿尤尔社区的武装青年发生冲突，战斗于周四上午11时左右开始，至下午5时在杜克帕尤尔镇郊外仍在继续。杜克县代理专员称，来自特维克东县的武装青年袭击了当地村庄，目前尚无伤亡细节，因为当地没有网络。民间社会人士指责政府不作为，呼吁开展基层对话。",
   "summary_original": "",
   "event_time": "2026-09-24T18:49:25Z",
   "published_time": "2026-09-24T18:49:25Z",
   "location": "",
   "china_related": false,
   "verification_level": "single_source",
   "verification_label_cn": "单一来源",
   "independent_source_count": 1,
   "source_links": [
    {
     "url": "https://www.radiotamazuj.org/en/news/article/fresh-violence-hits-duk-county-jonglei",
     "source_name": "Radio Tamazuj",
     "source_group": "ssd",
     "language": "en"
    }
   ],
   "potential_impact": "",
   "progress": "",
   "current_policy_passed": true,
   "quality_gate_passed": true,
