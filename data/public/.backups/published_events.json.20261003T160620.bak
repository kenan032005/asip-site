    {
     "url": "https://www.rfi.fr/fr/afrique/20261001-afrique-du-sud-apr%C3%A8s-la-s%C3%A9rie-de-f%C3%A9minicides-les-associations-r%C3%A9clament-une-r%C3%A9forme-judiciaire",
