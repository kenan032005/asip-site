   "source_links": [
    {
     "url": "https://www.rfi.fr/fr/podcasts/reportage-afrique/20260928-nigeria-%C3%A0-bille-la-pollution-au-gaz-est-une-bombe-%C3%A0-retardement-pour-la-sant%C3%A9-des-habitants-2-3",
