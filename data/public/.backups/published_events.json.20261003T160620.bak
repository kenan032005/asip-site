   "independent_source_count": 1,
   "source_links": [
    {
     "url": "https://www.rfi.fr/fr/afrique/20261001-rdc-le-d%C3%A9sarmement-des-fdlr-au-coeur-d-une-nouvelle-tourn%C3%A9e-d-%C3%A9missaires-congolais-en-afrique-et-en-europe",
