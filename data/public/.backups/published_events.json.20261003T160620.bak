   "title_cn": "尼日尔多索举办前战斗人员投降与重返社会区域研讨会",
   "title_original": "Dosso accueille un atelier régional sur la reddition et la réintégration des ex-combattants",
   "summary_cn": "尼日尔多索大区于2026年9月21日举办区域研讨会，旨在提高各方对前战斗人员及武装团体关联人员投降与重返社会进程的认识并加强相关能力。多索大区区长班纳·阿尔哈桑上校主持开幕式，强调自愿投降是减少暴力、帮助愿意脱离武装团体者重返社会的重要机会。国家稳定计划协调员戈尼·易卜拉欣表示，投降应被视为结构化进程的起点，而非孤立行为。",
   "summary_original": "",
   "event_time": "2026-09-21T12:10:19Z",
   "published_time": "2026-09-21T12:10:19Z",
   "location": "",
   "china_related": false,
   "verification_level": "single_source",
   "verification_label_cn": "单一来源",
   "independent_source_count": 1,
   "source_links": [],
   "potential_impact": "",
   "progress": "",
   "current_policy_passed": true,
   "quality_gate_passed": true,
