   "independent_source_count": 1,
   "source_links": [
    {
     "url": "https://www.radiotamazuj.org/en/news/article/27-passengers-freed-after-road-ambush-women-report-rape",
     "source_name": "Radio Tamazuj",
     "source_group": "ssd",
